{
  "productName": "agentOS GUI",
  "version": "0.1.0",
  "identifier": "io.agentos.gui",
  "build": {
    "beforeDevCommand": "vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label":         "main",
        "title":         "agentOS",
        "width":         1200,
        "height":        780,
        "minWidth":      900,
        "minHeight":     600,
        "decorations":   true,
        "transparent":   false,
        "resizable":     true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
